SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=write_products,read_inventory,read_locations,read_products

# Requis en local seulement. Sur Vercel, laisser vide : app-url.js retombe
# automatiquement sur VERCEL_PROJECT_PRODUCTION_URL en production.
SHOPIFY_APP_URL=

# Fournie automatiquement par l'intégration Postgres (Neon/Prisma Postgres)
# sur Vercel. En local, pointer vers une instance Postgres.
DATABASE_URL=
